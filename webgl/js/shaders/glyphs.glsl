/* GENERATED by tools/gen-glyphs.mjs — 3×5 bitmaps, row-major from the top left,
   bit (r*3+c). Used by the glyph pass in composite.glsl. */
const int GLYPH_RAMP[16] = int[16](0, 8192, 1040, 448, 3640, 1488, 21973, 2728, 11114, 21157, 24445, 31599, 31727, 15083, 31471, 32767);
const int GLYPH_HEX[16] = int[16](31599, 29850, 29671, 31207, 18925, 31183, 31695, 9383, 31727, 31215, 23530, 15083, 29263, 15211, 29647, 5071);
const int GLYPH_W = 3;
const int GLYPH_H = 5;
/* is the ink on inside this glyph, at cell coordinates (0..1)? */
float glyphInk(int glyph, vec2 cu) {
  if (cu.x < 0.0 || cu.x >= 1.0 || cu.y < 0.0 || cu.y >= 1.0) return 0.0;
  int g = clamp(glyph, 0, 15);
  vec2 c = cu * vec2(float(GLYPH_W), float(GLYPH_H));
  int cx = int(clamp(floor(c.x), 0.0, float(GLYPH_W - 1)));
  int cy = int(clamp(floor(c.y), 0.0, float(GLYPH_H - 1)));
  int bit = cy * GLYPH_W + cx;
  int bits = GLYPH_RAMP[g];
  return float((bits >> bit) & 1);
}
float glyphInkHex(int glyph, vec2 cu) {
  if (cu.x < 0.0 || cu.x >= 1.0 || cu.y < 0.0 || cu.y >= 1.0) return 0.0;
  int g = clamp(glyph, 0, 15);
  vec2 c = cu * vec2(float(GLYPH_W), float(GLYPH_H));
  int cx = int(clamp(floor(c.x), 0.0, float(GLYPH_W - 1)));
  int cy = int(clamp(floor(c.y), 0.0, float(GLYPH_H - 1)));
  int bit = cy * GLYPH_W + cx;
  int bits = GLYPH_HEX[g];
  return float((bits >> bit) & 1);
}
